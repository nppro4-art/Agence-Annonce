-- ChatBot et messages
CREATE TABLE IF NOT EXISTS "ChatBot" (
  "id" TEXT NOT NULL PRIMARY KEY,
  "code" TEXT NOT NULL UNIQUE,
  "userId" TEXT NOT NULL,
  "annonceId" TEXT NOT NULL UNIQUE,
  "titre" TEXT NOT NULL,
  "inputData" JSONB NOT NULL DEFAULT '{}',
  "actif" BOOLEAN NOT NULL DEFAULT true,
  "nbQuestions" INTEGER NOT NULL DEFAULT 0,
  "createdAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE IF NOT EXISTS "ChatMessage" (
  "id" TEXT NOT NULL PRIMARY KEY,
  "chatBotId" TEXT NOT NULL,
  "role" TEXT NOT NULL,
  "content" TEXT NOT NULL,
  "createdAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Colonne chatBotCode sur Annonce
ALTER TABLE "Annonce" ADD COLUMN IF NOT EXISTS "chatBotCode" TEXT UNIQUE;

-- Table Avis
CREATE TABLE IF NOT EXISTS "Avis" (
  "id" TEXT NOT NULL PRIMARY KEY,
  "nom" TEXT NOT NULL DEFAULT 'Anonyme',
  "ville" TEXT NOT NULL DEFAULT '',
  "article" TEXT NOT NULL DEFAULT '',
  "note" INTEGER NOT NULL,
  "commentaire" TEXT NOT NULL,
  "email" TEXT NOT NULL DEFAULT '',
  "statut" TEXT NOT NULL DEFAULT 'pending',
  "createdAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "updatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

-- Double authentification
CREATE TABLE IF NOT EXISTS "TwoFACode" (
  "id" TEXT NOT NULL PRIMARY KEY,
  "userId" TEXT NOT NULL UNIQUE,
  "code" TEXT NOT NULL,
  "expiresAt" TIMESTAMP NOT NULL,
  "used" BOOLEAN NOT NULL DEFAULT false,
  "createdAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

ALTER TABLE "User" ADD COLUMN IF NOT EXISTS "twoFAEnabled" BOOLEAN DEFAULT false;

-- Colonnes token et confirmed sur TwoFACode
ALTER TABLE "TwoFACode" ADD COLUMN IF NOT EXISTS "token" TEXT UNIQUE;
ALTER TABLE "TwoFACode" ADD COLUMN IF NOT EXISTS "confirmed" BOOLEAN DEFAULT false;
