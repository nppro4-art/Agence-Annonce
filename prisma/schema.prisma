generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  password         String
  name             String?
  plan             String         @default("free")
  planKey          String         @default("free")
  stripeCustomerId String?        @unique
  stripeSubId      String?        @unique
  subStatus        String         @default("inactive")
  refBy            String?
  referralCode     String?        @unique
  referralUsed     String?
  loyaltyPoints    Int            @default(0)
  twoFAEnabled     Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  annonces         Annonce[]
  reponses         Reponse[]
  credits          Credit[]
  purchases        Purchase[]
  objetsEnVente    ObjetEnVente[]
  alertesPrix      AlertePrix[]
  chatBots         ChatBot[]
  twoFACodes       TwoFACode[]
}

model Employee {
  id          String       @id @default(cuid())
  name        String
  code        String       @unique
  email       String?
  webhook     String?
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  clicks      Click[]
  commissions Commission[]
}

model Click {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  ip         String?
  converted  Boolean  @default(false)
  planKey    String?
  createdAt  DateTime @default(now())
}

model Commission {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  userId     String
  amount     Float
  type       String
  planKey    String   @default("business")
  paid       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Annonce {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  type         String
  inputData    Json
  titre        String?
  description  String?
  pointsForts  String?
  defauts      String?
  prixConseil  String?
  shortVersion String?
  score        Int?
  scoreGrade   String?
  chatBotCode  String?     @unique
  createdAt    DateTime    @default(now())
  chatBot      ChatBot?
}

model Reponse {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  messageAcheteur String
  reponsePrete    String
  suggestion      String?
  createdAt       DateTime @default(now())
}

model ChatBot {
  id          String        @id @default(cuid())
  code        String        @unique
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  annonceId   String        @unique
  annonce     Annonce       @relation(fields: [annonceId], references: [id])
  titre       String
  inputData   Json
  actif       Boolean       @default(true)
  nbQuestions Int           @default(0)
  createdAt   DateTime      @default(now())
  messages    ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatBotId String
  chatBot   ChatBot  @relation(fields: [chatBotId], references: [id])
  role      String   // 'user' ou 'assistant'
  content   String
  createdAt DateTime @default(now())
}

model Credit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  total     Int      @default(0)
  used      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, type])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  packName  String
  packType  String
  quantity  Int
  amount    Float
  stripeId  String?
  createdAt DateTime @default(now())
}

model ObjetEnVente {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  titre     String
  prix      Float
  prixFinal Float?
  statut    String   @default("actif")
  annonceId String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AlertePrix {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  motCle     String
  prixMoyen  Float?
  lastSentAt DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
}

model Avis {
  id          String   @id @default(cuid())
  nom         String   @default("Anonyme")
  ville       String   @default("")
  article     String   @default("")
  note        Int
  commentaire String
  email       String   @default("")
  statut      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TwoFACode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Settings {
  id                  String  @id @default("main")
  commissionFirst     Float   @default(6)
  commissionRecurring Float   @default(2)
  commissionStarter   Float   @default(0.50)
  commissionBusiness  Float   @default(1.50)
  commissionExpert    Float   @default(2.50)
  stripePrice         Float   @default(5.99)
  adminWebhook        String?
}
